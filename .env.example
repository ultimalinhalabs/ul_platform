# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Drizzle). Use the Supabase project's connection string, or any Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/ul_platform

# Supabase Auth (identity provider)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared JWT secret, used to verify Supabase-issued access tokens server-side (HS256).
SUPABASE_JWT_SECRET=
