# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Drizzle). Must be a Postgres instance/Supabase project DEDICATED to
# UL Platform — never point this at another asset's database (e.g. ultimalinha-landing).
# See CLAUDE.md §2: no shared database tables/instances across independent products.
DATABASE_URL=postgres://user:password@localhost:5432/ul_platform

# Supabase Auth (identity provider) — also its own dedicated Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared JWT secret, used to verify Supabase-issued access tokens server-side (HS256).
SUPABASE_JWT_SECRET=

# AES-256-GCM key for webhook signing-secret storage (base64, must decode to 32 bytes).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Reversible by design (unlike API-key hashing) — see modules/webhooks/crypto.ts.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# One-time platform-admin bootstrap (npm run platform:bootstrap-admin). NOT a
# secret — this is the target's Supabase user id (a UUID), used once to
# create the platform's first PLATFORM_ADMIN, then normally unset again.
# See scripts/bootstrap-platform-admin.ts and README "Platform Control Plane".
PLATFORM_ADMIN_BOOTSTRAP_USER_ID=
